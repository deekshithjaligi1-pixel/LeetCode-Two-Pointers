class Solution {
    public void reorderList(ListNode head) {
        ListNode prev = null;
        ListNode slow = head;
        ListNode fast = head;
        while(fast != null && fast.next != null) {
            slow = slow.next;
            fast = fast.next.next;
        }
        ListNode curr = slow.next;
        slow.next = null;

        while(curr !=null) {
            ListNode next = curr.next;
            curr.next = prev;
            prev = curr;
            curr = next;
        }

        ListNode first = head;
        ListNode second = prev;

        while(second != null) {
           ListNode firstNext = first.next;
           ListNode secondNext = second.next;

           first.next = second;
           second.next = firstNext;

           first = firstNext;
           second = secondNext;
        }
    }
}
